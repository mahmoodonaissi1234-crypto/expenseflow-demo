PORT=4000

# Local Docker Postgres (used when DATABASE_URL is not set)
PGHOST=localhost
PGPORT=5432
PGUSER=expenseflow
PGPASSWORD=expenseflow
PGDATABASE=expenseflow

# Hosted Postgres (Vercel/Neon/Supabase) — set this instead of the PG* vars
# above when deploying. Takes priority over PG* vars if both are set.
# DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# CORS
CLIENT_ORIGIN=http://localhost:5173
